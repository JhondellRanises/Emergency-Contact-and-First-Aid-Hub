<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/etAlertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alert title" />

        <EditText
            android:id="@+id/etAlertMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Alert message"
            android:minLines="3" />

        <EditText
            android:id="@+id/etAlertDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:hint="Pick date/time" />

        <Spinner
            android:id="@+id/spAlertType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSaveAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Schedule Alert" />

        <Button
            android:id="@+id/btnSendNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Send Urgent Alert Now" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Saved Alerts"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/lvAlerts"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</ScrollView>
